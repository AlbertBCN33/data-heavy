{
  "ci": {
    "collect": {
      "staticDistDir": "dist/apps/screener/browser",
      "isSinglePageApplication": true,
      "url": ["/", "/watchlist"],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox --lang=en-US"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "aggregationMethod": "median-run",
          "assertions": {
            "largest-contentful-paint": [
              "error",
              {
                "maxNumericValue": 2500
              }
            ],
            "cumulative-layout-shift": [
              "error",
              {
                "maxNumericValue": 0.1
              }
            ],
            "total-blocking-time": [
              "error",
              {
                "maxNumericValue": 200
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 1
              }
            ],
            "categories:performance": [
              "warn",
              {
                "minScore": 0.9
              }
            ],
            "resource-summary:script:size": [
              "error",
              {
                "maxNumericValue": 180000
              }
            ]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "dist/lighthouse"
    }
  }
}
